module(name = "adbeesh", version = "0.0.0")

bazel_dep(name = "rules_android", version = "0.7.3")
bazel_dep(name = "aspect_rules_lint", version = "2.6.0")

lint = use_extension("@aspect_rules_lint//lint:extensions.bzl", "tools")
lint.ktlint(name = "com_github_pinterest_ktlint")
use_repo(lint, "com_github_pinterest_ktlint")

bazel_dep(name = "rules_kotlin", version = "2.3.20")
bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "rules_jvm_external", version = "7.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_android_ndk", version = "0.1.5")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "protobuf", version = "33.4")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

# NDK is required for Jetpack Compose
android_ndk_repository_extension = use_extension(
    "@rules_android_ndk//:extension.bzl",
    "android_ndk_repository_extension"
)
use_repo(android_ndk_repository_extension, "androidndk")
register_toolchains("@androidndk//:all")

remote_android_extensions = use_extension(
    "@rules_android//bzlmod_extensions:android_extensions.bzl",
    "remote_android_tools_extensions")
use_repo(remote_android_extensions, "android_tools")

android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension")
use_repo(android_sdk_repository_extension, "androidsdk")

version = use_extension("//tools:version.bzl", "version_extension")
use_repo(version, "adbeesh_version")

maven.install(
    name = "adbeesh_maven",
    known_contributing_modules = ["adbeesh"],
    boms = [
        "androidx.compose:compose-bom:2026.04.01",
    ],
    artifacts = [
        "com.github.IndiTheo.Kadb:kadb:2.1.3-rc1",
        "com.github.IndiTheo.Kadb:kadb-android:2.1.3-rc1",
        "com.github.IndiTheo.Kadb:kadb-mdns:2.1.3-rc1",
        "com.github.IndiTheo.Kadb:kadb-mdns-android:2.1.3-rc1",
        # COMING FROM BOM
        "androidx.compose.ui:ui",
        "androidx.compose.material3:material3",
        "androidx.compose.material:material-icons-core",
        "androidx.compose.foundation:foundation",
        "androidx.compose.foundation:foundation-layout",
        ## PINNED BECAUSE ANDROIDX CONFLICTS ITS OWN TRANSITIVE DEPENDENCIES
        "androidx.collection:collection:1.5.0",
        "androidx.collection:collection-jvm:1.5.0",
        "androidx.lifecycle:lifecycle-common:2.9.4",
        "androidx.lifecycle:lifecycle-viewmodel:2.9.2",
        "androidx.lifecycle:lifecycle-viewmodel-ktx:2.9.2",
        "androidx.lifecycle:lifecycle-viewmodel-compose:2.9.2",
        "androidx.lifecycle:lifecycle-runtime:2.8.7",
        "androidx.lifecycle:lifecycle-runtime-ktx:2.8.7",
        "androidx.savedstate:savedstate:1.3.2",
        "androidx.concurrent:concurrent-futures:1.2.0",
        # ADDITIONS OVER BOM
        "androidx.activity:activity-compose:1.9.0",
        "androidx.core:core-ktx:1.13.1",
        "androidx.security:security-crypto:1.1.0-alpha06",
        # KOTLIN
        "org.jetbrains.kotlinx:kotlinx-coroutines-core:1.10.2",
        "org.jetbrains.kotlinx:kotlinx-coroutines-android:1.10.2",
        "org.jetbrains.kotlin:kotlin-metadata-jvm:2.3.21",
        "org.jetbrains.kotlin:kotlin-compose-compiler-plugin-embeddable:2.3.20",
        # SECURITY
        "org.conscrypt:conscrypt-android:2.5.2",
        "org.bouncycastle:bcprov-jdk18on:1.83",
        "org.bouncycastle:bcpkix-jdk18on:1.83",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
        "https://maven.google.com",
        "https://jitpack.io",
    ],
    fail_on_missing_checksum = False,
    lock_file = "//:adbeesh_maven_install.json",
    fail_if_repin_required = True,
    repin_instructions = "!!! Run 'REPIN=1 bazel run @unpinned_adbeesh_maven//:pin' to update the lockfile !!!",
    version_conflict_policy = "pinned",
)

maven.install(
    name = "dokka",
    artifacts = [
        "org.jetbrains.dokka:dokka-cli:2.2.0",
        "org.jetbrains.dokka:dokka-base:2.2.0",
        "org.jetbrains.dokka:analysis-kotlin-symbols:2.2.0",
        "org.jetbrains.kotlinx:kotlinx-html-jvm:0.9.1",
        "org.jetbrains.kotlin:kotlin-stdlib:2.2.0",
        "org.jetbrains.kotlin:kotlin-reflect:2.2.0",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
    lock_file = "//:dokka_install.json",
    fail_if_repin_required = True,
    repin_instructions = "!!! Run 'REPIN=1 bazel run @unpinned_dokka//:pin' to update the lockfile !!!",
)

use_repo(maven, "adbeesh_maven", "unpinned_adbeesh_maven", "dokka", "unpinned_dokka")
